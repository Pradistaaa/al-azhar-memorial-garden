---

const photos = {
  hero: 'https://alazharmemorialgarden.com/wp-content/uploads/2025/01/AMG-Aerial-Belakang-9.png',
  single: 'https://alazharmakam.co.id/wp-content/uploads/2024/08/1.-single.jpg',
  double: 'https://alazharmakam.co.id/wp-content/uploads/2024/10/4.-double-jpg.webp',
  family: 'https://alazharmakam.co.id/wp-content/uploads/2024/08/8.-family.jpg',
};

const benefits = [
  ['01', 'Sesuai Syariah Islam', 'Pengelolaan mengikuti prinsip pemakaman muslim yang sederhana dan bermartabat.'],
  ['02', 'Dikelola Sejak 2011', 'Dikelola oleh YPI Al Azhar sejak 2011 dengan komitmen pelayanan yang terjaga.'],
  ['03', 'Khusus Muslim', 'Kawasan pemakaman diperuntukkan khusus bagi umat Muslim.'],
  ['04', 'Akses Strategis', 'Akses yang mudah dijangkau untuk keluarga yang datang berziarah.'],
  ['05', 'Walkway Setiap Makam', 'Jalan setapak yang tertata untuk kenyamanan saat berziarah.'],
  ['06', 'Pendampingan Ustadz', 'Tersedia pendampingan rohani untuk membantu keluarga di masa duka.'],
  ['07', 'Mudah Ditemukan', 'Penataan blok yang rapi membantu lokasi makam mudah dikenali.'],
  ['08', 'Perawatan Rutin', 'Lingkungan taman dirawat secara berkala agar tetap teduh dan bersih.'],
  ['09', 'Layanan 24 Jam', 'Fasilitas dan pelayanan penguburan tersedia selama 24 jam.'],
  ['10', 'Mengarah Kiblat', 'Penataan setiap makam memperhatikan arah kiblat.'],
  ['11', 'Landscape Asri', 'Lanskap hijau yang tenang, rapi, dan nyaman untuk berziarah.'],
  ['12', 'Bebas Biaya Rumput', 'Pemeliharaan rumput dilakukan tanpa biaya tambahan selamanya.'],
];

const kavlings = [
  ['Single', 'Kaveling personal yang tenang dan tertata.', 'Satu area makam', photos.single],
  ['Double', 'Ruang peristirahatan berdampingan untuk pasangan.', 'Dua area makam', photos.double],
  ['Family', 'Pilihan area untuk keluarga dalam satu lingkungan.', 'Area keluarga', photos.family],
];
---

<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Al Azhar Memorial Garden - pemakaman muslim dengan layanan sesuai syariah di Karawang."
    />
    <title>Al Azhar Memorial Garden | Pemakaman Muslim</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <main>
      <section class="hero" id="beranda">
        <nav class="container nav">
          <a class="brand" href="#beranda" aria-label="Al Azhar Memorial Garden">
            <span class="brand-mark">✦</span>
            <span>
              <strong>AL AZHAR</strong>
              <small>MEMORIAL GARDEN</small>
            </span>
          </a>

          <div class="nav-links">
            <a href="#tentang">Tentang</a>
            <a href="#keunggulan">Keunggulan</a>
            <a href="#kaveling">Kaveling</a>
            <a href="#syariah">Syariah</a>
          </div>

          <a class="nav-contact" href="tel:082121020050">Hubungi Kami</a>
        </nav>

        <div class="container hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">Pemakaman Muslim di Karawang</p>
            <h1>Tempat peristirahatan yang <em>tenang</em> dan penuh makna.</h1>
            <p class="hero-text">
              Al Azhar Memorial Garden menghadirkan kawasan pemakaman Muslim yang
              tertata, asri, dan mengutamakan nilai-nilai syariah.
            </p>

            <div class="hero-actions">
              <a class="button button-primary" href="https://wa.me/6282121020050" target="_blank">
                Konsultasi via WhatsApp <span>↗</span>
              </a>
              <a class="button button-ghost" href="#keunggulan">Jelajahi Layanan</a>
            </div>

            <div class="hero-trust">
              <div>
                <strong>Sejak 2011</strong>
                <span>Dikelola YPI Al Azhar</span>
              </div>
              <div>
                <strong>24 Jam</strong>
                <span>Layanan penguburan</span>
              </div>
              <div>
                <strong>Khusus Muslim</strong>
                <span>Berlandaskan syariah</span>
              </div>
            </div>
          </div>

          <div class="hero-art photo-hero" aria-label="Foto Al Azhar Memorial Garden">
  <img
    src={photos.hero}
    alt="Landscape Al Azhar Memorial Garden"
    loading="eager"
  />

</div>
</div>
        <div class="hero-bottom container">
          <span>SCROLL UNTUK MENJELAJAHI</span>
          <i></i>
          <span>AL AZHAR MEMORIAL GARDEN</span>
        </div>
      </section>

      <section class="intro section" id="tentang">
        <div class="container intro-grid">
          <p class="section-label">Tentang kami</p>

          <div>
            <h2>Merawat kenangan dengan ketenangan yang <em>bermartabat.</em></h2>
            <p class="intro-text">
              Setiap keluarga layak memperoleh ruang untuk mengenang dalam suasana yang
              teduh. Kami menghadirkan kawasan pemakaman dengan penataan taman yang
              rapi, akses nyaman, dan pelayanan yang menghormati setiap proses.
            </p>
          </div>

          <div class="quote-card">
            <span class="quote-icon">“</span>
            <p>
              Pemakaman bukan hanya sebuah tempat, melainkan ruang untuk mendoakan,
              mengenang, dan menjaga ikatan keluarga.
            </p>
          </div>
        </div>
      </section>

      <section class="benefits section" id="keunggulan">
        <div class="container">
          <div class="section-heading">
            <div>
              <p class="section-label light">Mengapa memilih kami</p>
              <h2>12 alasan untuk memilih<br /><em>Al Azhar Memorial Garden.</em></h2>
            </div>
            <p>
              Pelayanan yang dipersiapkan dengan perhatian pada nilai syariah,
              kenyamanan keluarga, dan keindahan lingkungan.
            </p>
          </div>

          <div class="benefit-grid">
            {
              benefits.map(([number, title, description]) => (
                <article class="benefit-card">
                  <span>{number}</span>
                  <h3>{title}</h3>
                  <p>{description}</p>
                  <i>↗</i>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="kaveling section" id="kaveling">
        <div class="container">
          <div class="section-heading warm-heading">
            <div>
              <p class="section-label">Pilihan kaveling</p>
              <h2>Ruang yang disiapkan<br />untuk setiap <em>keluarga.</em></h2>
            </div>
            <p>
              Pilih kebutuhan kaveling dengan konsultasi bersama tim kami untuk
              memperoleh informasi ketersediaan dan penataan area.
            </p>
          </div>

       <div class="kaveling-grid">
  {
    kavlings.map(([title, text, meta, image], index) => (
      <article class:list={['kaveling-card', { featured: index === 1 }]}>
        <div class="card-garden photo-card">
          <img src={image} alt={`Kaveling ${title} Al Azhar Memorial Garden`} loading="lazy" />
        </div>

        <div class="kaveling-info">
          <span>{meta}</span>
          <h3>{title}</h3>
          <p>{text}</p>
          <a href="https://wa.me/6282121020050" target="_blank">
            Tanyakan ketersediaan <b>→</b>
          </a>
        </div>
      </article>
    ))
   }
</div>
</div>

      </section>

      <section class="syariah section" id="syariah">
        <div class="container syariah-grid">
          <div class="syariah-visual">
            <div class="arabic">۞</div>
            <span>BERLANDASKAN NILAI</span>
            <strong>SYARIAH</strong>
            <p>Menjaga kesederhanaan, kepatutan, dan kehormatan.</p>
          </div>

          <div class="syariah-copy">
            <p class="section-label">Prinsip pemakaman syariah</p>
            <h2>Kesederhanaan adalah bentuk <em>kemuliaan.</em></h2>
            <p>
              Pengelolaan kami memperhatikan ketentuan pemakaman Muslim, termasuk
              pemisahan area Muslim, arah kiblat, serta lingkungan yang terawat dan
              tidak berlebihan.
            </p>

            <ul>
              <li><span>01</span> Area pemakaman khusus Muslim.</li>
              <li><span>02</span> Penataan makam mengarah kiblat.</li>
              <li><span>03</span> Makam sederhana, rapi, dan tidak berlebihan.</li>
              <li><span>04</span> Jalan setapak disiapkan agar makam tidak terinjak.</li>
              <li><span>05</span> Batu nisan digunakan sebagai penanda makam.</li>
            </ul>
          </div>
        </div>
      </section>

      <section class="principle">
        <div class="container principle-grid">
          <div>
            <p class="section-label light">Nilai yang kami jaga</p>
            <h2>Tanpa <em>tabzir</em>,<br />tanpa <em>israf.</em></h2>
          </div>
          <div class="principle-text">
            <p>
              <strong>Tabzir</strong> adalah menggunakan atau membelanjakan harta untuk
              hal yang tidak perlu atau boros.
            </p>
            <p>
              <strong>Israf</strong> adalah sikap memperturutkan keinginan yang
              melampaui semestinya.
            </p>
          </div>
        </div>
      </section>

      <section class="contact section" id="kontak">
        <div class="container contact-card">
          <div>
            <p class="section-label">Mari berdiskusi</p>
            <h2>Temukan ketenangan<br />untuk keluarga Anda.</h2>
            <p>
              Kami siap membantu menjelaskan ketersediaan kaveling, proses pelayanan,
              dan informasi yang Anda perlukan.
            </p>
          </div>

          <div class="contact-actions">
            <a class="button button-primary" href="https://wa.me/6282121020050" target="_blank">
              Chat WhatsApp <span>↗</span>
            </a>
            <a class="phone" href="tel:082121020050">
              <small>Informasi pemesanan kaveling 24 jam</small>
              <strong>0821 2102 0050</strong>
            </a>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="container footer-grid">
        <div>
          <a class="brand footer-brand" href="#beranda">
            <span class="brand-mark">✦</span>
            <span>
              <strong>AL AZHAR</strong>
              <small>MEMORIAL GARDEN</small>
            </span>
          </a>
          <p>Ruang peristirahatan Muslim yang tenang, tertata, dan penuh makna.</p>
        </div>

        <div>
          <span class="footer-title">Lokasi</span>
          <p>Jl. Raya Peruri, Desa Pinayungan,<br />Telukjambe Timur, Karawang</p>
        </div>

        <div>
          <span class="footer-title">Kontak</span>
          <a href="tel:08138769242">0813 8769 242</a>
          <a href="tel:082121020050">0821 2102 0050</a>
        </div>
      </div>

      <div class="container copyright">
  <span>Developed & Designed by Pradista</span>
  <span>© 2026 Al Azhar Memorial Garden</span>
</div>
    </footer>

    <style>
      :global(*) {
        box-sizing: border-box;
      }

      :global(html) {
        scroll-behavior: smooth;
      }

      :global(body) {
        margin: 0;
        color: #183c36;
        background: #f8f5ee;
        font-family: "DM Sans", sans-serif;
      }

      :global(a) {
        color: inherit;
        text-decoration: none;
      }

      .container {
        width: min(1160px, calc(100% - 48px));
        margin: 0 auto;
      }

      .section {
        padding: 120px 0;
      }

      .section-label {
        margin: 0 0 16px;
        color: #b18a43;
        font-size: 0.73rem;
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
      }

      .section-label.light {
        color: #d7bc82;
      }

      h1,
      h2,
      h3,
      p {
        margin-top: 0;
      }

      h1,
      h2 {
        font-family: "Playfair Display", serif;
        font-weight: 600;
      }

      h1 em,
      h2 em {
        color: #bf974c;
        font-style: italic;
      }

      .hero {
        position: relative;
        overflow: hidden;
        min-height: 820px;
        color: #fffdf7;
        background:
          radial-gradient(circle at 80% 16%, rgba(204, 165, 91, 0.22), transparent 24%),
          linear-gradient(115deg, #092c29 0%, #0c433b 58%, #135449 100%);
      }

      .hero::before {
        position: absolute;
        inset: 0;
        opacity: 0.2;
        background-image:
          linear-gradient(30deg, transparent 49%, #e6d6ae 50%, transparent 51%),
          linear-gradient(150deg, transparent 49%, #e6d6ae 50%, transparent 51%);
        background-size: 64px 110px;
        content: "";
        mask-image: linear-gradient(to bottom, black, transparent 78%);
      }

      .nav {
  position: fixed;
  z-index: 100;
  top: 16px;
  left: 50%;
  display: flex;
  width: min(1160px, calc(100% - 48px));
  align-items: center;
  justify-content: space-between;
  padding: 14px 20px;
  border: 1px solid rgba(226, 195, 127, 0.22);
  border-radius: 10px;
  background: rgba(9, 44, 41, 0.88);
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.18);
  backdrop-filter: blur(14px);
  transform: translateX(-50%);
}

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
      }

      .brand-mark {
        display: grid;
        width: 36px;
        height: 36px;
        place-items: center;
        border: 1px solid #d8ba78;
        border-radius: 50%;
        color: #e4c681;
        font-size: 1.2rem;
      }

      .brand strong,
      .brand small {
        display: block;
      }

      .brand strong {
        font-family: "Playfair Display", serif;
        font-size: 0.98rem;
        letter-spacing: 0.08em;
      }

      .brand small {
        margin-top: 2px;
        font-size: 0.5rem;
        font-weight: 700;
        letter-spacing: 0.2em;
      }

      .nav-links {
        display: flex;
        gap: 28px;
        color: rgba(255, 255, 255, 0.76);
        font-size: 0.84rem;
      }

      .nav-links a:hover {
        color: #e3c57f;
      }

      .nav-contact {
        padding: 11px 17px;
        border: 1px solid rgba(226, 195, 127, 0.66);
        border-radius: 999px;
        color: #ecd49a;
        font-size: 0.77rem;
        font-weight: 700;
      }

      .hero-grid {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: 1fr 0.92fr;
        align-items: center;
        gap: 60px;
        min-height: 650px;
        padding: 140px 0 80px;
      }

      .eyebrow {
        margin-bottom: 20px;
        color: #e2c883;
        font-size: 0.73rem;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }

      h1 {
        max-width: 640px;
        margin-bottom: 24px;
        font-size: clamp(3.1rem, 5.4vw, 5.6rem);
        line-height: 0.99;
        letter-spacing: -0.055em;
      }

      .hero-text {
        max-width: 500px;
        color: rgba(255, 255, 255, 0.74);
        font-size: 1rem;
        line-height: 1.8;
      }

      .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        margin-top: 32px;
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 14px;
        padding: 15px 20px;
        border-radius: 4px;
        font-size: 0.82rem;
        font-weight: 700;
        transition: transform 0.2s ease, background 0.2s ease;
      }

      .button:hover {
        transform: translateY(-3px);
      }

      .button-primary {
        color: #163a35;
        background: #dfbd73;
      }

      .button-primary span {
        font-size: 1.1rem;
      }

      .button-ghost {
        border: 1px solid rgba(255, 255, 255, 0.28);
        color: #fff;
      }

      .hero-trust {
        display: flex;
        gap: 28px;
        margin-top: 52px;
      }

      .hero-trust div {
        display: grid;
        gap: 5px;
        padding-right: 26px;
        border-right: 1px solid rgba(255, 255, 255, 0.18);
      }

      .hero-trust div:last-child {
        padding-right: 0;
        border: 0;
      }

      .hero-trust strong {
        color: #e5c984;
        font-family: "Playfair Display", serif;
        font-size: 1.05rem;
      }

      .hero-trust span {
        color: rgba(255, 255, 255, 0.64);
        font-size: 0.69rem;
      }

      .hero-art {
        position: relative;
        min-height: 500px;
      }

      .sun {
        position: absolute;
        top: 40px;
        right: 60px;
        width: 90px;
        height: 90px;
        border-radius: 50%;
        background: #e5c67d;
        box-shadow: 0 0 0 18px rgba(229, 198, 125, 0.07);
      }

      .arch {
        position: absolute;
        width: 260px;
        height: 350px;
        border: 2px solid rgba(239, 217, 162, 0.55);
        border-radius: 130px 130px 0 0;
      }

      .arch-back {
        top: 45px;
        right: 100px;
        opacity: 0.45;
      }

      .arch-front {
        top: 85px;
        right: 20px;
        border-color: rgba(239, 217, 162, 0.75);
      }

      .garden {
        position: absolute;
        right: 0;
        bottom: 0;
        width: 100%;
        height: 320px;
        overflow: hidden;
        border: 1px solid rgba(235, 216, 164, 0.28);
        border-radius: 180px 180px 0 0;
        background:
          linear-gradient(135deg, transparent 49%, rgba(249, 246, 225, 0.58) 50%, transparent 51%) 0 0 / 86px 68px,
          linear-gradient(25deg, #225e4e, #16473e);
      }

      .garden::after {
        position: absolute;
        bottom: -70px;
        left: -5%;
        width: 110%;
        height: 200px;
        border-radius: 50% 50% 0 0;
        background: #0e382f;
        content: "";
      }

      .path {
        position: absolute;
        z-index: 2;
        height: 24px;
        background: #ece7ce;
        transform: rotate(-17deg);
      }

      .path-one {
        top: 126px;
        left: -20px;
        width: 110%;
      }

      .path-two {
        top: 185px;
        left: 25px;
        width: 80%;
        transform: rotate(25deg);
      }

      .plot {
        position: absolute;
        z-index: 3;
        width: 76px;
        height: 36px;
        border: 4px solid #e8e6d7;
        border-radius: 4px 4px 14px 14px;
        background: #3b8a59;
        box-shadow: 0 8px 0 rgba(0, 0, 0, 0.08);
      }

      .plot-a { top: 58px; left: 72px; }
      .plot-b { top: 100px; left: 205px; }
      .plot-c { top: 192px; left: 115px; }
      .plot-d { top: 150px; right: 55px; }

      .tree {
        position: absolute;
        z-index: 4;
        width: 45px;
        height: 45px;
        border-radius: 50% 50% 45% 45%;
        background: #78a94f;
        box-shadow: inset -9px -10px 0 rgba(24, 84, 52, 0.25);
      }

      .tree::after {
        position: absolute;
        bottom: -22px;
        left: 20px;
        width: 7px;
        height: 24px;
        background: #8e6940;
        content: "";
      }

      .tree-a { top: 42px; left: 25px; }
      .tree-b { top: 78px; right: 52px; }
      .tree-c { bottom: 65px; left: 50px; }
      .tree-d { bottom: 48px; right: 135px; }

      .garden-label {
        position: absolute;
        z-index: 6;
        top: 24px;
        left: 28px;
        display: grid;
        gap: 6px;
      }

      .garden-label span {
        color: #dfc27c;
        font-size: 0.57rem;
        font-weight: 700;
        letter-spacing: 0.2em;
      }

      .garden-label strong {
        max-width: 180px;
        font-family: "Playfair Display", serif;
        font-size: 1.35rem;
        line-height: 1.1;
      }

      .hero-bottom {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 14px;
        padding-bottom: 24px;
        color: rgba(255, 255, 255, 0.48);
        font-size: 0.57rem;
        font-weight: 700;
        letter-spacing: 0.16em;
      }

      .hero-bottom i {
        display: block;
        width: 60px;
        height: 1px;
        background: #c1a460;
      }

      .intro {
        background: #fbf9f3;
      }

      .intro-grid {
        display: grid;
        grid-template-columns: 0.46fr 1.2fr 0.75fr;
        gap: 55px;
        align-items: start;
      }

      h2 {
        margin-bottom: 24px;
        color: #143f37;
        font-size: clamp(2.3rem, 4vw, 4rem);
        line-height: 1.07;
        letter-spacing: -0.045em;
      }

      .intro-text {
        max-width: 620px;
        color: #5d7069;
        font-size: 1rem;
        line-height: 1.85;
      }

      .quote-card {
        padding: 28px;
        border-top: 2px solid #c6a35e;
        background: #f0eadc;
      }

      .quote-icon {
        color: #bd9650;
        font-family: "Playfair Display", serif;
        font-size: 3.4rem;
        line-height: 0.6;
      }

      .quote-card p {
        margin: 18px 0 0;
        color: #35584e;
        font-family: "Playfair Display", serif;
        font-size: 1.15rem;
        line-height: 1.5;
      }

      .benefits {
        color: #fff;
        background: #0c3f37;
      }

      .benefits h2 {
        color: #fffdf7;
      }

      .section-heading {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 42px;
        margin-bottom: 48px;
      }

      .section-heading > p {
        max-width: 330px;
        margin-bottom: 8px;
        color: rgba(255, 255, 255, 0.64);
        font-size: 0.94rem;
        line-height: 1.75;
      }

      .benefit-grid {
        display: grid;
